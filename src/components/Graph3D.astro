---
/**
 * A simple, stylised Arestrix graph that turns in 3D under the pointer: four rectangular vertices
 * with dependency edges, a decision edge and flowing dashes. The whole drawing is
 * one SVG plane tilted in perspective; the nodes only pulse, so the edges stay
 * connected. Pointer movement over the graph rotates it in 3D.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const nodes = [
  { x: 160, y: 32, w: 80, h: 44, delay: "0s", active: true },
  { x: 48, y: 148, w: 80, h: 44, delay: "0.5s", active: false },
  { x: 272, y: 148, w: 80, h: 44, delay: "1s", active: false },
  { x: 160, y: 276, w: 80, h: 44, delay: "1.5s", active: false },
];
---

<span class:list={["graph3d", className]} data-graph3d>
  <svg
    viewBox="0 0 400 400"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="graph3d-svg"
  >
    <g class="graph3d-plane">
    <path class="graph3d-edge" d="M200 76 C200 112 88 112 88 148" />
    <path class="graph3d-edge" d="M200 76 C200 112 312 112 312 148" />
    <path class="graph3d-edge" d="M88 192 C88 236 200 232 200 276" />
    <path class="graph3d-edge" d="M312 192 C312 236 200 232 200 276" />
    <path class="graph3d-edge graph3d-edge-decision" d="M128 170 H272" />
    <path class="graph3d-flow" d="M200 76 C200 112 88 112 88 148" />
    <path class="graph3d-flow" d="M200 76 C200 112 312 112 312 148" />
    <path class="graph3d-flow graph3d-flow-late" d="M88 192 C88 236 200 232 200 276" />

    {
      nodes.map((node) => (
        <g class="graph3d-node" style={`--d:${node.delay}`}>
          <rect
            class:list={["graph3d-box", node.active && "graph3d-box-active"]}
            x={node.x}
            y={node.y}
            width={node.w}
            height={node.h}
            rx="7"
          />
          <line
            class:list={["graph3d-head", node.active && "graph3d-head-active"]}
            x1={node.x + 12}
            y1={node.y + 12}
            x2={node.x + node.w - 12}
            y2={node.y + 12}
          />
          <line class="graph3d-line" x1={node.x + 12} y1={node.y + 26} x2={node.x + node.w - 20} y2={node.y + 26} />
          <line class="graph3d-line" x1={node.x + 12} y1={node.y + 35} x2={node.x + node.w - 34} y2={node.y + 35} />
          <circle
            class:list={["graph3d-port", node.active && "graph3d-port-active"]}
            cx={node.x + node.w}
            cy={node.y + node.h / 2}
            r="2.6"
          />
        </g>
      ))
    }
    </g>
  </svg>
</span>

<script>
  // Rotate the graph in 3D while the pointer is over it. The base tilt stays put when
  // the pointer leaves, and reduced-motion visitors get no listeners at all.
  const graphs = [...document.querySelectorAll<HTMLElement>("[data-graph3d]")];
  const still = matchMedia("(prefers-reduced-motion: reduce)");

  if (graphs.length && !still.matches) {
    for (const graph of graphs) {
      const reset = () => {
        graph.style.setProperty("--gx", "0deg");
        graph.style.setProperty("--gy", "0deg");
      };

      graph.addEventListener(
        "pointermove",
        (event) => {
          if (still.matches || event.pointerType === "touch") return;
          const box = graph.getBoundingClientRect();
          const nx = (event.clientX - box.left) / box.width - 0.5;
          const ny = (event.clientY - box.top) / box.height - 0.5;
          graph.style.setProperty("--gx", `${(-ny * 18).toFixed(2)}deg`);
          graph.style.setProperty("--gy", `${(nx * 24).toFixed(2)}deg`);
        },
        { passive: true },
      );

      graph.addEventListener("pointerleave", reset);
      graph.addEventListener("pointercancel", reset);
    }

    still.addEventListener("change", () => {
      if (still.matches) for (const graph of graphs) {
        graph.style.setProperty("--gx", "0deg");
        graph.style.setProperty("--gy", "0deg");
      }
    });
  }
</script>

<style>
  .graph3d {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    overflow: visible;
    color: var(--c-white);
    perspective: 900px;
    perspective-origin: 50% 50%;
  }
  .graph3d-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: rotateX(calc(8deg + var(--gx, 0deg))) rotateY(calc(-10deg + var(--gy, 0deg)));
    transform-origin: 50% 50%;
    transform-style: preserve-3d;
    transition: transform 0.35s var(--ease-out);
    will-change: transform;
  }
  .graph3d-edge {
    stroke: currentColor;
    stroke-opacity: 0.22;
    stroke-width: 1.3;
  }
  .graph3d-edge-decision {
    stroke: var(--accent);
    stroke-opacity: 0.45;
    stroke-dasharray: 3 5;
  }
  .graph3d-flow {
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 2 14;
    opacity: 0.9;
  }
  .graph3d-box {
    fill: currentColor;
    fill-opacity: 0.045;
    stroke: currentColor;
    stroke-opacity: 0.42;
    stroke-width: 1.2;
  }
  .graph3d-box-active {
    fill: var(--accent);
    fill-opacity: 0.08;
    stroke: var(--accent);
    stroke-opacity: 0.9;
  }
  .graph3d-head {
    stroke: currentColor;
    stroke-opacity: 0.32;
  }
  .graph3d-head-active {
    stroke: var(--accent);
    stroke-opacity: 0.9;
  }
  .graph3d-line {
    stroke: currentColor;
    stroke-opacity: 0.22;
  }
  .graph3d-port {
    fill: currentColor;
    stroke: none;
    opacity: 0.4;
  }
  .graph3d-port-active {
    fill: var(--accent);
    opacity: 0.9;
  }
</style>
