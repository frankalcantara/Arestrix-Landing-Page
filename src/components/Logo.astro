---
/**
 * The Arestrix logo (negative version, Papel on Grafite) from the brand manual.
 * The wordmark already carries the name, so there is no separate text node.
 */
import { SITE } from "../config";

interface Props {
  class?: string;
}
---

<span class:list={["logo inline-flex items-center", Astro.props.class]}>
  <img
    src="/brand/arestrix-logo-reverse.svg"
    alt={SITE.name}
    width="200"
    height="47"
    class="h-auto w-[180px] lg:w-[200px]"
    decoding="async"
  />
</span>
