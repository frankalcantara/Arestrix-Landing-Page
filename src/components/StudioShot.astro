---
/**
 * A real Arestrix Studio screenshot in a compact window frame. The source images live in
 * public/media and are crops of docs/assets/screenshots. The frame has a slow scroll-linked
 * "camera" move; without motion, reduced motion or JavaScript the image simply shows.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  label?: string;
  class?: string;
  loading?: "lazy" | "eager";
  /** CSS object-position, e.g. "center top". */
  position?: string;
}

const {
  src,
  alt,
  width,
  height,
  label,
  class: className,
  loading = "lazy",
  position = "center",
} = Astro.props;
---

<figure class:list={["studio-shot", className]}>
  <div class="studio-shot-frame">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      style={`object-position:${position}`}
    />
    {
      label && (
        <span class="studio-shot-label" aria-hidden="true">
          <span class="studio-shot-dot" aria-hidden="true" />
          {label}
        </span>
      )
    }
  </div>
  <slot />
</figure>

<style>
  .studio-shot {
    display: block;
    margin: 0;
  }
  .studio-shot-frame {
    position: relative;
    overflow: clip;
    border: 1px solid var(--cap-card-border);
    border-radius: 14px;
    background: var(--cap-card);
    box-shadow: 0 30px 70px -50px rgb(0 0 0 / 0.9);
  }
  .studio-shot-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 1px 0 rgb(244 242 238 / 0.12);
  }
  .studio-shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .studio-shot-label {
    position: absolute;
    left: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 8px;
    border: 1px solid rgb(244 242 238 / 0.2);
    border-radius: 999px;
    background: rgb(11 12 15 / 0.82);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-white);
    white-space: nowrap;
  }
  .studio-shot-dot {
    width: 5px;
    height: 5px;
    flex: none;
    border-radius: 50%;
    background: var(--accent);
  }
  .studio-shot :global(figcaption) {
    margin-top: 10px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--c-muted);
  }
</style>
