---
/**
 * Get the beta. The Windows installer and portable ZIP are the fastest paths; building from
 * source works on Windows and Linux; arestrix-cli is the headless path for servers and CI.
 * Requirements and install steps come from README.md and docs/en/getting-started.md.
 */
import Icon from "../Icon.astro";
import { SITE } from "../../config";

const paths = [
  {
    icon: "download" as const,
    tag: "Recommended",
    title: "Windows installer",
    body: "Per-user install in %LOCALAPPDATA%\\Programs\\Arestrix, without administrator rights. It checks WebView2, the VC++ Redistributable, Git credentials, MSVC Build Tools and provider keys.",
    href: SITE.releases,
    link: "Download the .exe",
  },
  {
    icon: "package" as const,
    tag: "Portable",
    title: "Windows ZIP",
    body: "Extract the archive anywhere and run start-arestrix.bat. The extracted folder becomes ARESTRIX_HOME, so the whole install can live on a removable drive.",
    href: SITE.releases,
    link: "Download the .zip",
  },
  {
    icon: "terminal" as const,
    tag: "Windows and Linux",
    title: "Build from source",
    body: "Git 2.30+, Node.js 20+, Python 3.10+, CMake 3.20+ and a C++20 compiler. Clone with submodules, install the frontend dependencies and run the native build.",
    href: SITE.gettingStarted,
    link: "Read the build steps",
  },
  {
    icon: "server" as const,
    tag: "Headless",
    title: "arestrix-cli",
    body: "Ships with the Studio. Generate, compile and run the same graph without the UI, with --ci, batch mode and stable exit codes for servers and pipelines.",
    href: SITE.cliDocs,
    link: "Read the CLI reference",
  },
];
---

<section id="download" class="download scroll-mt-28" aria-labelledby="download-title">
  <div class="container-x">
    <div class="download-head">
      <div>
        <p class="eyebrow">Beta 2.1 · 2.1.0-beta.1</p>
        <h2 id="download-title" class="h-section download-title">
          Get <span class="hl">Beta 2.1</span>
        </h2>
      </div>
      <p class="lead download-lead">
        Start with the Windows build, build from source on Windows or Linux, or run the same engine headless in CI.
        No account and no hosted workspace.
      </p>
    </div>

    <ul class="download-grid">
      {
        paths.map((path, i) => (
          <li class="download-card reveal" style={`--i:${i}`}>
            <div class="download-card-top">
              <span class="download-icon">
                <Icon name={path.icon} size={22} />
              </span>
              <span class="download-tag">{path.tag}</span>
            </div>
            <h3>{path.title}</h3>
            <p>{path.body}</p>
            <a href={path.href} class="feature-link" target="_blank" rel="noopener">
              {path.link} <Icon name="arrow-up-right" size={18} />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="download-run reveal">
      <div class="download-run-copy">
        <p class="eyebrow">From source</p>
        <h3>Four commands to the Studio</h3>
        <p>
          The build compiles the C++ backend and the frontend, then opens the Studio. Linux uses the same entry point;
          programs generated from a graph currently target Windows.
        </p>
        <div class="download-links">
          <a href={SITE.releases} class="btn btn-primary" target="_blank" rel="noopener">
            Latest release <Icon name="arrow-up-right" class="icon-shift" />
          </a>
          <a href={SITE.examples} class="btn btn-secondary" target="_blank" rel="noopener">
            Browse the examples
          </a>
        </div>
      </div>

      <div class="download-console">
        <div class="download-console-head">
          <span class="download-console-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>terminal</span>
        </div>
        <pre><code><span class="d-prompt">$</span> git clone --recurse-submodules https://github.com/frankalcantara/Arestrix.git
<span class="d-prompt">$</span> cd Arestrix
<span class="d-prompt">$</span> npm ci
<span class="d-prompt">$</span> python CppCore/dev.py</code></pre>
      </div>
    </div>

    <p class="download-integrity reveal">
      <Icon name="shield-check" size={18} class="shrink-0 text-accent" />
      <span>
        Every build ships <code>SHA256SUMS</code>, <code>SBOM.json</code> and a per-file{" "}
        <code>package-manifest.json</code>. Windows artifacts are signed by SignPath Foundation when signing is enabled.
        Read the <a href={SITE.changelog} target="_blank" rel="noopener">changelog</a> for the current limitations.
      </span>
    </p>
  </div>
</section>

<style>
  .download {
    padding-block: 48px;
  }
  .download-head {
    display: grid;
    gap: 20px;
  }
  .download-title {
    margin-top: 10px;
    font-size: min(9vw, 62px);
    line-height: 1.1;
  }
  .download-lead {
    max-width: 40rem;
  }
  .download-grid {
    display: grid;
    gap: 20px;
    margin-top: 48px;
  }
  .download-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: 26px;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-media);
    background: var(--c-surface);
    color: var(--c-ink);
  }
  .download-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .download-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--c-line);
    border-radius: 10px;
    color: var(--accent);
  }
  .download-tag {
    padding: 4px 9px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
    white-space: nowrap;
  }
  .download-card h3 {
    margin-top: 8px;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.04em;
    color: var(--accent);
  }
  .download-card p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--c-muted);
  }
  .download-card .feature-link {
    margin-top: auto;
    align-self: flex-start;
  }
  .download-run {
    display: grid;
    gap: 32px;
    margin-top: 24px;
    padding: 32px;
    border: 1px solid var(--cap-card-border);
    border-radius: var(--radius-media);
    background: var(--cap-card);
    color: var(--cap-card-text);
  }
  .download-run h3 {
    margin-top: 10px;
    font-size: clamp(28px, 6vw, 38px);
    line-height: 1.1;
    letter-spacing: -0.045em;
  }
  .download-run-copy > p:not(.eyebrow) {
    max-width: 44ch;
    margin-top: 14px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--cap-card-text);
  }
  .download-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .download-console {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--cap-card-border);
    border-radius: 14px;
    background: #08090b;
  }
  .download-console-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--c-line);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .download-console-dots {
    display: flex;
    gap: 5px;
  }
  .download-console-dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-line);
  }
  .download-console-dots i:last-child {
    background: var(--accent);
  }
  .download-console pre {
    padding: 18px 16px 20px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.8;
    color: var(--cap-card-text);
  }
  .download-console code {
    white-space: pre;
  }
  .d-prompt {
    color: var(--accent);
  }
  .download-integrity {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    max-width: 60rem;
    margin-top: 24px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--c-muted);
  }
  .download-integrity code {
    padding: 1px 5px;
    border: 1px solid var(--c-line);
    border-radius: 5px;
    background: rgb(244 242 238 / 0.045);
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--c-white);
  }
  .download-integrity a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  @media (max-width: 750px) {
    .download-console code {
      white-space: pre-wrap;
      overflow-wrap: normal;
    }
  }
  @media (min-width: 751px) {
    .download {
      padding-block: 96px;
    }
    .download-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 64px;
    }
    .download-card {
      padding: 30px;
    }
    .download-run {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: 48px;
      margin-top: 20px;
      padding: 40px;
    }
  }
  @media (min-width: 1001px) {
    .download {
      padding-block: 120px;
    }
    .download-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      align-items: end;
      gap: 64px;
    }
    .download-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .download-card {
      padding: 26px;
    }
    .download-card h3 {
      font-size: 22px;
    }
  }
</style>
