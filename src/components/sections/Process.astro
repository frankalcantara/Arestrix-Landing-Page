---
/**
 * 11. Process: a near-black panel that slides in from the left edge of the screen as it scrolls in,
 * next to a 3D graph that stays in place (sticky). Each step = dot + title + paragraph; when a
 * step reaches the screen its dot opens, its title tilts in and its paragraph is wiped up into
 * view ([data-enter] in effects.css). Edit the steps below.
 */
import Graph3D from "../Graph3D.astro";

const steps = [
  {
    title: "Draw the graph",
    body: "Start from a template or an empty canvas. The Office-inspired ribbon gives you agents, tools, decisions and feedback loops; validation catches an incomplete graph before a model call.",
  },
  {
    title: "Inspect the code",
    body: "Arestrix translates the graph into C++20 and opens it in Monaco. Parallel branches become Taskflow tasks, with no hidden interpreter between the canvas and the binary.",
  },
  {
    title: "Run with telemetry",
    body: "Press F5 to compile and run. Watch node latency, token throughput, live reasoning streams and tool arguments, then resume a batch without starting over.",
  },
  {
    title: "Export and package",
    body: "Ship a standalone runner with an HMAC integrity manifest, or package it as MSI/MSIX for managed Windows deployment. Credentials resolve at runtime through DPAPI or Azure Key Vault.",
  },
];
---

<section class="process" aria-labelledby="process-title">
  <div class="process-panel">
    <h2 id="process-title" class="sr-only">How Arestrix works</h2>
    <ol class="steps">
      {
        steps.map((step) => (
          <li class="step">
            <span class="step-dot" data-enter="dot" aria-hidden="true" />
            <h3 class="step-title" data-enter="tilt">
              {step.title}
            </h3>
            <p class="step-body" data-enter="rise">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="process-side" aria-hidden="true">
    <div class="process-graph-wrap">
      <Graph3D class="process-graph" />
    </div>
  </div>
</section>

<style>
  .process {
    position: relative;
    display: flex;
    overflow-x: clip;
  }
  .process-panel {
    flex: none;
    width: 65%;
    padding: 48px 24px;
    border: 1px solid var(--cap-card-border);
    border-left: 0;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--cap-card);
    color: var(--cap-card-text);
  }
  .steps {
    display: grid;
    gap: 24px;
  }
  .step-dot {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
  }
  .step-title {
    margin-top: 12px;
    font-size: 5.94728vw;
    font-weight: 700;
    line-height: 1.3;
    color: var(--accent);
  }
  .step-body {
    margin-top: 12px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--cap-card-text);
  }
  .process-side {
    flex: 1;
    min-width: 0;
  }
  .process-graph-wrap {
    position: sticky;
    top: 144px;
    margin-top: 98px;
    height: 133px;
  }
  .process-graph-wrap :global(.process-graph) {
    width: 100%;
    height: 100%;
  }
  @media (min-width: 751px) {
    .process-panel {
      padding: 50vh 0 144px;
    }
    .steps {
      width: 450px;
      max-width: calc(100% - 48px);
      margin-inline: auto;
      gap: 96px;
    }
    .step-dot {
      width: 24px;
      height: 24px;
    }
    .step-title {
      margin-top: 24px;
      font-size: 38px;
    }
    .step-body {
      margin-top: 24.6px;
      font-size: 24px;
    }
    .process-graph-wrap {
      top: 34vh;
      margin-block: 20vh;
      height: 60vh;
    }
  }
</style>
