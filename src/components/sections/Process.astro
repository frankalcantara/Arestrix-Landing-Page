---
/**
 * From canvas to package. The four steps use the stacked-card scroll effect from the reference
 * (openbot.run/#teams): each card sticks below the previous one, scales down and dims as the
 * next card covers it, while the aside tracks the active step.
 *
 * The cards stay near-black with Papel type and line art, as the brand manual requires. The
 * card art is ServiceArt (graph, code, runner, shield), so the existing line animations apply.
 */
import ServiceArt from "../ServiceArt.astro";
import Icon from "../Icon.astro";
import { SITE } from "../../config";

const steps = [
  {
    label: "Design",
    title: "Draw the graph",
    art: "graph",
    body: "Start from a template or an empty canvas. Add agents, tools, decisions, switches, subflows and feedback loops, then validate the graph before a model call. Missing models, unresolved variables and unreachable vertices are reported on the canvas.",
    href: SITE.graphDocs,
    linkLabel: "Graph and nodes",
  },
  {
    label: "Compile",
    title: "Inspect the code",
    art: "code",
    body: "Arestrix generates C++20 and opens it in Monaco. Parallel branches become Taskflow tasks; condition and switch vertices become branches; loops become Taskflow loops. An unchanged graph reuses the previous binary.",
    href: SITE.architectureDocs,
    linkLabel: "How compilation works",
  },
  {
    label: "Run",
    title: "Run with telemetry",
    art: "runner",
    body: "Press F5. Live thinking streams, node latency, token throughput, tool arguments and 429 retries arrive on the canvas and in the console. Batch runs checkpoint each item and resume from the last completed vertex.",
    href: SITE.agentDocs,
    linkLabel: "Agents and execution",
  },
  {
    label: "Ship",
    title: "Export and package",
    art: "shield",
    body: "Ship a standalone runner with a focused progress screen, or package it as MSI/MSIX for managed Windows deployment. The package carries an HMAC/SHA-256 manifest; credentials resolve at runtime through DPAPI or Azure Key Vault.",
    href: SITE.agentDocs,
    linkLabel: "Standalone runner",
  },
] as const;
---

<section id="process" class="process scroll-mt-28" aria-labelledby="process-title">
  <div class="container-x process-grid">
    <aside class="process-aside">
      <p class="eyebrow">From canvas to package</p>
      <h2 id="process-title" class="h-section process-title mask-rise" style="--i:0">
        One graph.<br /><span class="hl">Four artifacts.</span>
      </h2>
      <p class="lead process-lead mask-rise" style="--i:1">
        Each step leaves something you can inspect: the graph, the C++20, the run trace and the packaged runner.
      </p>

      <ol class="process-progress" aria-label="Steps in this section">
        {
          steps.map((step, i) => (
            <li data-process-step class:list={["process-progress-item", i === 0 && "is-active"]}>
              <span class="process-progress-num">{String(i + 1).padStart(2, "0")}</span>
              <span>{step.title}</span>
            </li>
          ))
        }
      </ol>

      <a href={SITE.architectureDocs} class="feature-link process-link" target="_blank" rel="noopener">
        Read the architecture <Icon name="arrow-up-right" size={18} />
      </a>
    </aside>

    <ol class="process-stack" data-process-stack>
      {
        steps.map((step, i) => (
          <li class="process-card" data-process-card style={`--i:${i}`}>
            <div class="process-card-top">
              <span class="process-label">
                {String(i + 1).padStart(2, "0")} / 04 · {step.label}
              </span>
              <span class="process-card-number" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>

            <ServiceArt kind={step.art} class="process-art" />

            <div class="process-card-copy">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              <a href={step.href} class="feature-link" target="_blank" rel="noopener">
                {step.linkLabel} <Icon name="arrow-up-right" size={18} />
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // Track how much of each card is covered by the next one, and which step the aside is on.
  // The visual effect is CSS-only (see the media query below); this script only supplies
  // --covered and the active progress item. Without JavaScript the cards simply show.
  const stack = document.querySelector<HTMLElement>("[data-process-stack]");
  if (stack) {
    const cards = [...stack.querySelectorAll<HTMLElement>("[data-process-card]")];
    const steps = [...document.querySelectorAll<HTMLElement>("[data-process-step]")];
    const wide = matchMedia("(min-width: 1101px)");
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;

    const update = () => {
      frame = 0;
      const style = getComputedStyle(stack);
      const top = parseFloat(style.getPropertyValue("--stack-top")) || 112;
      const step = parseFloat(style.getPropertyValue("--stack-step")) || 52;
      const animate = wide.matches && !still.matches;
      let active = 0;

      cards.forEach((card, i) => {
        const rect = card.getBoundingClientRect();
        const next = cards[i + 1];
        let covered = 0;

        if (animate && next) {
          const nextRect = next.getBoundingClientRect();
          const distance = Math.max(1, rect.height - step);
          covered = Math.min(1, Math.max(0, (rect.bottom - nextRect.top) / distance));
        }

        card.style.setProperty("--covered", covered.toFixed(3));
        if (rect.top <= top + i * step + 1) active = i;
      });

      steps.forEach((item, i) => item.classList.toggle("is-active", i === active));
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    addEventListener("scroll", schedule, { passive: true });
    addEventListener("resize", schedule);
    wide.addEventListener("change", schedule);
    still.addEventListener("change", schedule);
    update();
  }
</script>

<style>
  .process {
    position: relative;
    padding-block: 48px;
    overflow-x: clip;
  }
  /* The section starts with a transparent-to-line gradient instead of a hard rule. */
  .process::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--c-line) 18%,
      var(--c-line) 82%,
      transparent 100%
    );
  }
  .process-grid {
    display: grid;
    gap: 48px;
  }
  .process-title {
    margin-top: 12px;
    font-size: min(8vw, 58px);
    line-height: 1.12;
  }
  .process-lead {
    max-width: 36rem;
    margin-top: 24px;
  }
  .process-progress {
    display: none;
    margin-top: 36px;
    border-left: 1px solid var(--c-line);
  }
  .process-progress-item {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 10px 0 10px 20px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-muted);
    transition: color 0.2s;
  }
  .process-progress-item::before {
    content: "";
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: -1px;
    width: 2px;
    border-radius: 999px;
    background: var(--accent);
    scale: 1 0;
    transform-origin: top;
    transition: scale 0.2s var(--ease-out);
  }
  .process-progress-item.is-active {
    color: var(--c-ink);
  }
  .process-progress-item.is-active::before {
    scale: 1;
  }
  .process-progress-num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--c-dim);
  }
  .process-progress-item.is-active .process-progress-num {
    color: var(--accent);
  }
  .process-link {
    margin-top: 32px;
  }
  .process-stack {
    display: grid;
    gap: 20px;
  }
  .process-card {
    --covered: 0;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 330px;
    padding: 28px;
    overflow: clip;
    border: 1px solid var(--cap-card-border);
    border-top-color: transparent;
    border-radius: 24px;
    background: var(--cap-card);
    color: var(--cap-card-text);
    box-shadow: 0 -20px 40px -28px rgb(0 0 0 / 0.7);
  }
  .process-card::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--cap-card-border) 12%,
      var(--cap-card-border) 88%,
      transparent 100%
    );
  }
  .process-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(244 242 238 / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(244 242 238 / 0.055) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(120% 100% at 86% 18%, #000 10%, transparent 70%);
    mask-image: radial-gradient(120% 100% at 86% 18%, #000 10%, transparent 70%);
  }
  .process-card > * {
    position: relative;
    z-index: 1;
  }
  .process-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .process-label,
  .process-card-number {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .process-card-number {
    color: var(--accent);
  }
  .process-card :global(.process-art) {
    width: 190px;
    max-width: 56%;
    margin-top: 20px;
    margin-left: auto;
    color: var(--cap-card-text);
    opacity: 0.9;
  }
  .process-card-copy {
    align-self: end;
    margin-top: 20px;
  }
  .process-card-copy h3 {
    font-size: clamp(34px, 8vw, 44px);
    line-height: 1;
    letter-spacing: -0.055em;
    color: var(--cap-card-text);
    text-wrap: balance;
  }
  .process-card-copy p {
    max-width: 36ch;
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--cap-card-text);
    text-wrap: pretty;
  }
  .process-card-copy .feature-link {
    margin-top: 22px;
  }

  /* The stacking effect. The script keeps the default at --covered: 0, so reduced motion,
     phones and browsers without the script get flat, fully lit cards. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 1101px) {
    .process-stack {
      --stack-top: 112px;
      --stack-step: 52px;
    }
    .process-card {
      position: sticky;
      top: calc(var(--stack-top) + var(--i) * var(--stack-step));
      min-height: 440px;
      padding: 32px;
      border-radius: 28px;
    }
    .process-card :global(.process-art) {
      position: absolute;
      top: 92px;
      right: 32px;
      width: min(30%, 260px);
      margin: 0;
      opacity: 0.85;
    }
    .process-card-copy {
      margin-top: auto;
      max-width: 60%;
    }
    .process-card-copy h3 {
      font-size: clamp(42px, 4vw, 56px);
    }
  }
  @media (min-width: 751px) {
    .process {
      padding-block: 96px;
    }
    .process-progress {
      display: grid;
    }
    .process-card-copy h3 {
      font-size: 46px;
    }
  }
  @media (min-width: 1101px) {
    .process {
      padding-block: 120px;
    }
    .process-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: clamp(48px, 6vw, 88px);
    }
    .process-aside {
      position: sticky;
      top: 112px;
    }
    .process-title {
      font-size: 58px;
    }
  }
</style>