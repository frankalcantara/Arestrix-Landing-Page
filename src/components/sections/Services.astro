---
/**
 * 8. Two-tone heading that fills on scroll, and 9. the service cards.
 *
 * Wide screens: the cards start as a staircase (each one 300px below the one before), and as you
 * scroll each card pulls up and locks into its place in the grid (position: sticky), row 1 at
 * 144px from the top of the screen, row 2 under it. Every card sits in its own "track"; all tracks
 * end together, so the finished grid scrolls away as one block the moment the last card locks.
 * Each card also flips in (3D) the first time it reaches the screen. Phones get a plain stack.
 */
import { getCollection } from "astro:content";
import FillLines from "../FillLines.astro";
import ServiceCard from "../ServiceCard.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);

/** Staircase geometry for `cols` columns: track top, sticky top and track bottom for card k. */
const STEP = 300; // px between consecutive cards before they lock
const ROW = 294; // card height (270) + gap (24)
const place = (k: number, cols: number) => {
  const r = Math.floor(k / cols);
  const rows = Math.ceil(services.length / cols);
  return { c: k % cols, t: STEP * k + (ROW - 6) * r, st: 144 + ROW * r, b: (rows - 1 - r) * ROW };
};
const height = (cols: number) => place(services.length - 1, cols).t + 270;
---

<section class="services overflow-x-clip" aria-labelledby="services-title">
  <div class="container-x">
    <div class="svc-intro">
      <div>
        <FillLines as="h2" id="services-title" class="h-section svc-heading" lines={["Built for *delivery*"]} ranges={[[25, 70]]} />
        <p class="lead svc-lead mask-rise" style="--i:1">
          Six parts of the studio that take an agent pipeline from the canvas to a package IT can deploy.
        </p>
        <span class="rule svc-rule" aria-hidden="true"></span>
      </div>

      <!-- Contents for the staircase below: the same six parts, in the order they run. -->
      <ol class="svc-index" aria-label="The six parts">
        {
          services.map((service, i) => (
            <li class="svc-index-item" data-enter="row" style={`--i:${i}`}>
              <span class="svc-index-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="svc-index-label">{service.data.label}</span>
              <span class="svc-index-title">{service.data.title}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <ul class="svc-grid" style={`--h3:${height(3)}px;--h2:${height(2)}px`}>
      {
        services.map((service, k) => {
          const a = place(k, 3);
          const b = place(k, 2);
          return (
            <ServiceCard
              service={service}
              style={`--c3:${a.c};--t3:${a.t}px;--st3:${a.st}px;--b3:${a.b}px;--c2:${b.c};--t2:${b.t}px;--st2:${b.st}px;--b2:${b.b}px`}
            />
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .services {
    padding-block: 48px;
  }
  .svc-intro {
    display: grid;
    gap: 32px;
  }
  .svc-index {
    display: none;
  }
  .svc-lead {
    width: 78%;
  }
  .svc-rule {
    margin-top: 24px;
  }
  .svc-grid {
    display: grid;
    gap: 24px;
    margin-top: 48px;
  }
  @media (min-width: 751px) {
    .services {
      padding-block: 144px;
    }
    .svc-lead {
      width: 360px;
    }
    .svc-rule {
      margin-top: 48px;
    }
    .svc-grid {
      position: relative;
      display: block;
      height: var(--h2);
      margin-top: 148px;
    }
  }
  @media (min-width: 900px) {
    .svc-grid {
      height: var(--h3);
    }
  }
  /* Desktop: the heading on the left, the six-part contents on the right, so the
     first screen of the section is composed instead of half empty. */
  @media (min-width: 1001px) {
    .svc-intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      align-items: start;
      gap: clamp(48px, 6vw, 88px);
    }
    .svc-index {
      display: grid;
      margin-top: 6px;
      list-style: none;
    }
    .svc-index-item {
      display: grid;
      grid-template-columns: 24px 6.5rem minmax(0, 1fr);
      align-items: baseline;
      gap: 12px;
      padding: 9px 0;
      border-top: 1px solid var(--c-line);
    }
    .svc-index-item:last-child {
      border-bottom: 1px solid var(--c-line);
    }
    .svc-index-num {
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.4;
      color: var(--accent);
    }
    .svc-index-label {
      font-family: var(--font-mono);
      font-size: 10px;
      line-height: 1.4;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--c-muted);
    }
    .svc-index-title {
      font-size: 15px;
      line-height: 1.4;
      color: var(--c-ink);
    }
    .svc-grid {
      margin-top: 96px;
    }
  }
</style>
