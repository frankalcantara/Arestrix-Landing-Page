---
/**
 * What it costs. Arestrix is MIT licensed; there is no per-seat price, locked tier or hosted
 * subscription. The big zero is decorative; the plain-text answer is in the sr-only paragraph.
 */
import Icon from "../Icon.astro";
import { SITE } from "../../config";

const facts = [
  {
    label: "The software",
    body: "MIT licensed. Commercial and academic use included.",
  },
  {
    label: "The infrastructure",
    body: "Studio, runner and gateway run where you put them.",
  },
  {
    label: "The model bill",
    body: "Billed by the provider or endpoint you choose. Local models bypass gateway budgets.",
  },
];
---

<section id="pricing" class="pricing scroll-mt-28" aria-labelledby="pricing-title">
  <div class="pricing-glow" aria-hidden="true"></div>
  <div class="container-x pricing-inner">
    <p class="eyebrow pricing-kicker mask-rise" style="--i:0">What it costs</p>
    <h2 id="pricing-title" class="sr-only">Arestrix is free and MIT licensed</h2>

    <p class="pricing-amount mask-rise" style="--i:1" aria-hidden="true"><span class="pricing-currency">$</span><span class="pricing-zero">0</span></p>
    <p class="sr-only">
      Arestrix costs zero dollars. It is MIT licensed, with no per-seat fee, locked features or hosted
      subscription. Model usage is billed by the provider or endpoint you choose.
    </p>

    <p class="pricing-note mask-rise" style="--i:2">
      Arestrix is free. No per-seat fee. No locked features. You pay your model provider — or nothing,
      if you run a local model.
    </p>

    <ul class="pricing-facts stagger">
      {
        facts.map((fact, i) => (
          <li style={`--i:${i}`}>
            <span class="pricing-fact-label">{fact.label}</span>
            <span class="pricing-fact-body">{fact.body}</span>
          </li>
        ))
      }
    </ul>

    <div class="pricing-actions">
      <a href={SITE.releases} class="btn btn-primary" target="_blank" rel="noopener">
        Get the beta <Icon name="arrow-up-right" class="icon-shift" />
      </a>
      <a href={SITE.license} class="btn btn-secondary" target="_blank" rel="noopener">Read the license</a>
    </div>

    <p class="pricing-fine">
      No account, no hosted workspace and no credit card. The source is on{" "}
      <a href={SITE.repo} target="_blank" rel="noopener">GitHub</a>.
    </p>
  </div>
</section>

<style>
  /* Papel section: a deliberate light break in the page. Grafite carries the type, Brasa is
     reserved for the currency, the icon-sized details and the rule above the figure. */
  .pricing {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: 72px;
    border-block: 1px solid var(--c-paper-line);
    background: var(--card);
    color: var(--card-text);
    text-align: center;
  }
  .pricing-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .pricing-glow::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(20 21 26 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(20 21 26 / 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(58% 62% at 50% 50%, #000 0%, transparent 72%);
    mask-image: radial-gradient(58% 62% at 50% 50%, #000 0%, transparent 72%);
  }
  .pricing-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pricing-kicker {
    color: var(--c-ardosia);
  }
  .pricing-kicker::after {
    content: "";
    display: block;
    width: 64px;
    height: 1px;
    margin: 12px auto 0;
    background: var(--accent);
  }
  /* Solid type instead of background-clip: the zero never loses its right edge, and the
     padding gives the glyph's side bearing room inside the element's box. */
  .pricing-amount {
    display: inline-flex;
    align-items: baseline;
    max-width: 100%;
    margin-top: 8px;
    padding: 0.04em 0.08em;
    overflow: visible;
    font-size: clamp(140px, 25vw, 300px);
    font-weight: 700;
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
    color: var(--card-text);
  }
  .pricing-currency {
    font-size: 0.32em;
    line-height: 1;
    letter-spacing: 0;
    vertical-align: 0.62em;
    color: var(--accent);
  }
  .pricing-zero {
    letter-spacing: -0.05em;
  }
  .pricing-note {
    max-width: 44rem;
    margin-top: 8px;
    font-size: min(5.2vw, 24px);
    line-height: 1.4;
    color: var(--card-text);
    text-wrap: balance;
  }
  .pricing-facts {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    max-width: 64rem;
    margin-top: 48px;
    border-top: 1px solid var(--c-paper-line);
    border-bottom: 1px solid var(--c-paper-line);
    text-align: left;
  }
  .pricing-facts li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 0;
    border-bottom: 1px solid var(--c-paper-line);
  }
  .pricing-facts li:last-child {
    border-bottom: 0;
  }
  .pricing-fact-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ardosia);
  }
  .pricing-fact-label::before {
    content: "";
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: var(--accent);
  }
  .pricing-fact-body {
    max-width: 34ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--card-text);
  }
  .pricing-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
  }
  .pricing .btn-secondary {
    border-color: rgb(20 21 26 / 0.3);
    color: var(--card-text);
  }
  .pricing .btn-secondary:hover {
    border-color: rgb(20 21 26 / 0.6);
    background: rgb(20 21 26 / 0.04);
  }
  .pricing-fine {
    margin-top: 20px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--c-paper-muted);
  }
  .pricing-fine a {
    color: var(--card-text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .pricing-fine a:hover {
    text-decoration-thickness: 2px;
  }
  @media (min-width: 751px) {
    .pricing {
      padding-block: 120px;
    }
    .pricing-facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .pricing-facts li {
      gap: 10px;
      padding: 24px 28px;
      border-right: 1px solid var(--c-paper-line);
      border-bottom: 0;
    }
    .pricing-facts li:first-child {
      padding-left: 0;
    }
    .pricing-facts li:last-child {
      padding-right: 0;
      border-right: 0;
    }
    .pricing-fact-body {
      font-size: 16px;
    }
  }
  @media (min-width: 1001px) {
    .pricing {
      padding-block: 160px;
    }
    .pricing-note {
      font-size: 24px;
    }
  }
</style>