---
/**
 * Project memory: a split section with the product claims on the left and a small
 * memory-ledger panel on the right, followed by the measured results.
 *
 * Copy follows docs/en/how-memory-works.md at memory-v1.0.1: memory is opt-in, chosen
 * per vertex as off, consult or learn; knowledge is a local graph of lessons, claims,
 * source passages, paths and playbooks; proposals and paths wait for validation. The
 * numbers come from the real DeepSeek reports and the deterministic paired A/B pilot,
 * never from a benchmark or an estimate. The ledger is decorative; the copy carries
 * the meaning for screen readers.
 */
import SectionHeading from "../SectionHeading.astro";
import Icon from "../Icon.astro";
import { SITE } from "../../config";

const points = [
  "Off, consult or learn, set per vertex",
  "Lessons, claims and source passages in one local graph",
  "Paths activate only after distinct validated runs",
  "Lexical + vector retrieval over a fingerprinted index",
  "Proposals wait for approval; evidence keeps the proof",
  "Knowledge and telemetry in separate SQLite databases",
];

const rows = [
  {
    type: "Source · passage",
    text: "runbook.md § retry policy · sha 9f2c",
    chip: "ingested",
    tone: "muted",
  },
  {
    type: "Claim · lens",
    text: "gateway/retry uses a 2 s backoff · valid to 2026-12",
    chip: "active",
    tone: "accent",
  },
  {
    type: "Canonical path",
    text: "MCP timeout → backoff → revalidate · 3 inputs",
    chip: "active",
    tone: "accent",
  },
  {
    type: "Playbook",
    text: "remote MCP recovery · validator-approved",
    chip: "candidate",
    tone: "muted",
  },
];

const results = [
  {
    label: "Prompt tokens",
    value: "−87%",
    detail: "Context substitution: 24,718 → 3,228 prompt tokens, with the same ORION-42 answer.",
  },
  {
    label: "Long interaction",
    value: "ORION-42",
    detail:
      "Memory ON cited the code in 9 calls / 14,164 tokens. OFF answered UNKNOWN in 8 calls / 8,475 tokens.",
  },
  {
    label: "Paired A/B pilot",
    value: "120/120",
    detail:
      "Validated observations across 20 tasks × 3 repetitions × 2 arms on frozen knowledge.",
  },
];
---

<section id="memory" class="memory scroll-mt-28" aria-labelledby="memory-title">
  <div class="container-x">
    <div class="memory-grid">
      <div class="memory-copy">
        <p class="eyebrow">Project memory · opt-in</p>
        <SectionHeading
          id="memory-title"
          class="mt-3"
          title="Memory that stays *with the project*"
          lead="Arestrix keeps what a run learned in the project's own SQLite graph: lessons, claims, source passages and validated paths. An agent reads a token-budgeted brief before it acts, and new knowledge waits for approval."
        />

        <ul class="stagger mt-8 grid gap-3 sm:grid-cols-2">
          {
            points.map((point, i) => (
              <li class="flex gap-3 text-ink" style={`--i:${i}`}>
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>

        <div class="memory-actions">
          <a href="/services/#project-memory" class="feature-link">
            Read the memory page <Icon name="arrow-right" size={18} />
          </a>
          <a href={SITE.memoryDocs} class="feature-link" target="_blank" rel="noopener">
            How memory works <Icon name="arrow-up-right" size={18} />
          </a>
        </div>
      </div>

      <div class="memory-visual" data-enter="panel" aria-hidden="true">
        <div class="memory-panel">
          <div class="memory-panel-head">
            <span class="font-mono text-xs tracking-[0.08em] text-muted">memory_search</span>
            <span class="memory-badge">hybrid retrieval</span>
          </div>

          <p class="memory-query">
            <span class="text-accent">›</span>
            <span>memory_search(&#123; query: "MCP retry policy" &#125;)</span>
          </p>

          <ol class="memory-stack">
            {
              rows.map((row, i) => (
                <li class="memory-row" data-enter="row" style={`--i:${i}`}>
                  <span class="memory-node" />
                  <span class="memory-row-copy">
                    <span class="memory-type">{row.type}</span>
                    <span class="memory-text">{row.text}</span>
                  </span>
                  <span class:list={["memory-chip", row.tone === "accent" && "memory-chip-accent"]}>
                    {row.chip}
                  </span>
                </li>
              ))
            }
          </ol>

          <div class="memory-brief">
            <span class="memory-brief-label">consult · token-budgeted brief</span>
            <p>1 path · 2 claims · 1 passage · 1.1k tokens</p>
          </div>
        </div>
      </div>
    </div>

    <div class="memory-results" data-enter="row">
      <div class="memory-results-head">
        <p class="eyebrow">Measured · controlled tests</p>
        <h3>Tested, not promised.</h3>
        <p>
          Two controlled runs against the real DeepSeek API and one deterministic paired pilot.
          Each test holds its fixture fixed and compares memory with a control arm.
        </p>
      </div>

      <dl class="memory-stats">
        {
          results.map((result) => (
            <div class="memory-stat">
              <dt>{result.label}</dt>
              <dd>
                <span class="memory-stat-value">{result.value}</span>
                <span class="memory-stat-detail">{result.detail}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <p class="memory-results-note">
        Recorded 2 November 2026 for memory v1.0.1. Controlled fixtures, not a benchmark;
        experimental retrieval switches remain off by default. Read the{" "}
        <a href={SITE.memoryTestStrategy} target="_blank" rel="noopener">test strategy</a> or the{" "}
        <a href={SITE.memoryRelease} target="_blank" rel="noopener">memory v1.0.1 notes</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .memory {
    padding-block: 48px;
  }
  .memory-grid {
    display: grid;
    gap: 48px;
  }
  .memory-copy :global(.rule) {
    margin-top: 32px;
  }
  .memory-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    margin-top: 32px;
  }
  .memory-panel {
    position: relative;
    overflow: clip;
    padding: 24px;
    border: 1px solid var(--cap-card-border);
    border-radius: var(--radius-media);
    background: var(--cap-card);
  }
  .memory-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .memory-badge,
  .memory-chip {
    display: inline-flex;
    align-items: center;
    padding: 4px 9px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
    white-space: nowrap;
  }
  .memory-chip-accent {
    border-color: color-mix(in srgb, var(--accent) 58%, transparent);
    color: var(--accent);
  }
  .memory-query {
    display: flex;
    gap: 10px;
    margin-top: 22px;
    padding: 13px 14px;
    border: 1px solid var(--c-line);
    border-radius: 10px;
    background: rgb(244 242 238 / 0.035);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--c-ink);
    overflow: hidden;
  }
  .memory-stack {
    position: relative;
    display: grid;
    gap: 10px;
    margin-top: 22px;
  }
  .memory-stack::before {
    content: "";
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: 5px;
    width: 1px;
    background: var(--c-line);
  }
  .memory-stack::after {
    content: "";
    position: absolute;
    top: 8px;
    left: 3px;
    width: 5px;
    height: 30px;
    border-radius: 4px;
    background: var(--accent);
    opacity: 0;
  }
  .memory-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 14px;
    padding: 11px 0 11px 26px;
  }
  .memory-node {
    position: absolute;
    top: 15px;
    left: 0;
    width: 11px;
    height: 11px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: var(--cap-card);
  }
  .memory-row-copy {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .memory-type {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .memory-text {
    font-size: 15px;
    line-height: 1.45;
    color: var(--c-ink);
  }
  .memory-chip {
    align-self: start;
    margin-top: 17px;
  }
  .memory-brief {
    margin-top: 22px;
    padding: 13px 14px;
    border-left: 2px solid var(--accent);
    background: rgb(244 242 238 / 0.035);
  }
  .memory-brief-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .memory-brief p {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--c-ink);
  }
  .memory-results {
    margin-top: 56px;
    padding: 24px;
    border: 1px solid var(--cap-card-border);
    border-radius: var(--radius-media);
    background: var(--cap-card);
  }
  .memory-results-head {
    max-width: 54rem;
  }
  .memory-results-head h3 {
    margin-top: 12px;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--cap-card-text);
  }
  .memory-results-head p {
    max-width: 62ch;
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--c-muted);
  }
  .memory-stats {
    display: grid;
    margin-top: 28px;
    border-top: 1px solid var(--c-line);
  }
  .memory-stat {
    display: grid;
    gap: 8px;
    padding: 20px 0;
    border-bottom: 1px solid var(--c-line);
  }
  .memory-stat:last-child {
    border-bottom: 0;
  }
  .memory-stat dt {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .memory-stat dd {
    display: grid;
    gap: 6px;
    margin: 0;
  }
  .memory-stat-value {
    font-size: clamp(34px, 5vw, 50px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent);
  }
  .memory-stat-detail {
    max-width: 34ch;
    font-size: 13px;
    line-height: 1.55;
    color: var(--c-muted);
    text-wrap: pretty;
  }
  .memory-results-note {
    max-width: 82ch;
    margin-top: 24px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--c-muted);
  }
  .memory-results-note a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .memory-results-note a:hover {
    color: var(--c-ink);
  }
  @media (min-width: 751px) {
    .memory {
      padding-block: 96px;
    }
    .memory-panel,
    .memory-results {
      padding: 28px;
    }
    .memory-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 0;
    }
    .memory-stat {
      padding: 4px 24px 4px 0;
      border-bottom: 0;
    }
    .memory-stat + .memory-stat {
      padding-left: 24px;
      border-left: 1px solid var(--c-line);
    }
  }
  @media (min-width: 1001px) {
    .memory {
      padding-block: 120px;
    }
    .memory-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: 80px;
    }
    .memory-results {
      padding: 40px;
    }
  }
</style>
