---
/** 10. Split section: a large paragraph and the accent button, next to a rounded picture that scales up as it scrolls in. */
import Ridgelines from "../Ridgelines.astro";
import { SITE } from "../../config";
---

<section class="split" aria-label="Own your pipeline">
  <div class="container-x split-col">
    <div class="split-pic">
      <div class="split-frame">
        <Ridgelines />
      </div>
    </div>
    <p class="t-big split-text">
      Most agent tools hand you a runtime you cannot inspect. Arestrix hands you the artifact: the graph, the generated
      C++20, the build metadata and a standalone runner. If a model provider changes tomorrow, the pipeline still belongs
      to you.
    </p>
    <a
      href={SITE.docs}
      class="btn btn-primary split-btn"
      target="_blank"
      rel="noopener"
    >Read the docs</a>
  </div>
</section>

<style>
  .split {
    padding-block: 48px;
  }
  .split-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .split-pic {
    width: 100%;
    height: 49.87vw;
  }
  .split-frame {
    height: 100%;
    overflow: clip;
    border-radius: var(--radius-media);
    background: var(--c-surface);
  }
  .split-frame :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .split-text {
    width: 90%;
    margin: 24px 0 0 5%;
    font-size: min(4.948827vw, 38px);
  }
  .split-btn {
    margin: 25px 0 0 5%;
  }
  /* Desktop: picture on the right half (588 × 780 at 1440), text and button in the left half. */
  @media (min-width: 1001px) {
    .split {
      padding-block: 96px 240px;
    }
    .split-col {
      position: relative;
      min-height: 780px;
      padding-top: 96px;
    }
    .split-pic {
      position: absolute;
      top: 0;
      right: 0;
      width: 49%;
      height: 780px;
    }
    .split-text {
      width: 49%;
      margin: 0;
      font-size: 38px;
    }
    .split-btn {
      margin: 24px 0 0;
    }
  }
</style>
