---
/**
 * Closing acknowledgement. This is an independent recommendation, not an affiliation:
 * the copy says so explicitly so the page never implies that OpenCode endorses Arestrix.
 */
import Icon from "../Icon.astro";
import { SITE } from "../../config";
---

<section id="acknowledgement" class="acknowledgement" aria-labelledby="ack-title">
  <div class="container-x">
    <div class="ack-panel" data-enter="panel">
      <p class="eyebrow ack-eyebrow">Acknowledgement · independent</p>
      <h2 id="ack-title" class="ack-title mask-rise" style="--i:0">Thank you, <span class="ack-name">OpenCode</span>.</h2>
      <p class="ack-lead">
        OpenCode is an excellent open-source AI coding agent. It runs in the terminal, IDE or desktop,
        works with free models or any provider, and is private by design.
      </p>
      <p class="ack-body">
        We use OpenCode and recommend it strongly. It is fast, careful and pleasant to work with, and it has
        earned a permanent place in our workflow. If you write software with AI, start with the free models
        and see for yourself.
      </p>

      <div class="ack-foot">
        <a href={SITE.opencode} class="btn btn-secondary ack-btn" target="_blank" rel="noopener">
          Visit OpenCode <Icon name="arrow-up-right" class="icon-shift" />
        </a>
        <p class="ack-note">
          Arestrix is not affiliated with, sponsored by or endorsed by OpenCode. OpenCode has not reviewed
          or endorsed Arestrix. This is an independent thank-you and recommendation.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .acknowledgement {
    padding-block: 24px 48px;
  }
  .ack-panel {
    position: relative;
    overflow: clip;
    padding: 30px;
    border: 1px solid rgb(244 242 238 / 0.22);
    border-radius: var(--radius-media);
    background: var(--c-ardosia);
    color: var(--c-white);
    box-shadow: 0 30px 70px -50px rgb(0 0 0 / 0.9);
  }
  /* Accent hairline across the top edge, drawn in on scroll (effects.css). */
  .ack-panel::after {
    content: "";
    position: absolute;
    top: 0;
    left: 30px;
    right: 30px;
    height: 2px;
    z-index: 2;
    pointer-events: none;
    background: var(--accent);
    transform-origin: left center;
    opacity: 0.85;
  }
  .ack-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(244 242 238 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(244 242 238 / 0.05) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(110% 100% at 92% 0%, #000 8%, transparent 66%);
    mask-image: radial-gradient(110% 100% at 92% 0%, #000 8%, transparent 66%);
  }
  .ack-panel > * {
    position: relative;
    z-index: 1;
  }
  .ack-eyebrow {
    color: rgb(244 242 238 / 0.82);
  }
  .ack-title {
    margin-top: 12px;
    font-size: clamp(32px, 4.6vw, 48px);
    line-height: 1.05;
    letter-spacing: -0.045em;
    color: var(--c-white);
  }
  .ack-name {
    position: relative;
    display: inline-block;
    color: var(--c-white);
  }
  /* The accent underline is drawn in, not typed. */
  .ack-name::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.02em;
    height: 2px;
    background: var(--accent);
    transform-origin: left center;
  }
  .ack-lead {
    max-width: 52rem;
    margin-top: 20px;
    font-size: clamp(19px, 2.2vw, 24px);
    line-height: 1.4;
    color: var(--c-white);
    text-wrap: balance;
  }
  .ack-body {
    max-width: 62ch;
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.6;
    color: rgb(244 242 238 / 0.86);
    text-wrap: pretty;
  }
  .ack-foot {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid rgb(244 242 238 / 0.2);
  }
  .ack-btn {
    align-self: flex-start;
    flex: none;
  }
  .ack-note {
    max-width: 58ch;
    font-size: 12px;
    line-height: 1.55;
    color: rgb(244 242 238 / 0.84);
  }
  @media (min-width: 751px) {
    .acknowledgement {
      padding-block: 32px 96px;
    }
    .ack-panel {
      padding: 40px;
    }
    .ack-foot {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
    }
    .ack-note {
      max-width: 34ch;
      text-align: left;
    }
  }
  @media (min-width: 1001px) {
    .acknowledgement {
      padding-block: 40px 120px;
    }
  }
</style>
