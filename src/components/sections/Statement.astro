---
/**
 * 5. Statement that fills line by line on scroll, and 6. a real Studio screenshot beside a paragraph.
 * On wide screens this block slides up over the sticky hero (see .hero-wrap in index.astro).
 */
import FillLines from "../FillLines.astro";
import StudioShot from "../StudioShot.astro";
---

<section class="statement" aria-label="What Arestrix does">
  <div class="container-x statement-col">
    <FillLines
      class="h-statement statement-text"
      lines={["Draw the graph.", "Compile it to *C++20*.", "Ship a *native runner*."]}
    />
    <div class="statement-body">
      <StudioShot
        src="/media/studio-graph.webp"
        alt="Arestrix Studio graph canvas with agent, task, condition and output vertices"
        width={1320}
        height={760}
        label="Studio · graph"
        class="statement-shot"
      />
      <p class="t-big statement-para">
        Arestrix validates the graph, generates C++20 source and compiles it with Taskflow into parallel task DAGs.
        Projects, memory and logs stay on your machine; only model and MCP calls leave it, plus the Git sync you opt into.
      </p>
    </div>
  </div>
</section>

<style>
  /* Phones and tablets: one column in the page flow (the offsets reproduce the reference at 375px). */
  .statement {
    position: relative;
    z-index: 1;
    padding-block: 48px 48.7px;
    background: var(--c-bg);
  }
  .statement-col {
    position: relative;
    height: 100%;
  }
  .statement-col :global(.statement-text .fl + .fl) {
    margin-top: 0.037em;
  }
  .statement-body {
    display: block;
  }
  .statement-para {
    margin-top: 28px;
    line-height: 1.3;
  }
  .statement :global(.statement-shot) {
    margin-top: 32px;
  }
  /* Desktop (the reference at 1440 × 727): a 1089px block; graph left, paragraph in the right half. */
  @media (min-width: 1001px) {
    .statement {
      height: 1089px;
      padding-block: 0;
    }
    .statement-col :global(.statement-text) {
      position: absolute;
      top: 288px;
      left: 0;
      right: 0;
    }
    .statement-col :global(.statement-text .fl + .fl) {
      margin-top: 0;
    }
    /* One grid row for the graph and the paragraph: align-items:center keeps their
       centres on the same line at every desktop width. The 567px offset puts the
       paragraph back at its original 630px when the 471px graph is the taller item. */
    .statement-body {
      position: absolute;
      top: 567px;
      left: 0;
      right: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
    .statement :global(.statement-shot) {
      width: 100%;
      max-width: 600px;
      margin: 0;
    }
    .statement-para {
      margin: 0;
    }
  }
</style>
