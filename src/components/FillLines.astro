---
/**
 * 5, 8, 12. Text that fills as it scrolls through the screen, one line at a time: the words in
 * *asterisks* turn from grey to the accent behind a front that sweeps left to right (it can stop
 * mid-word). Each line is two copies of the same text: a grey one, and over it a copy with the
 * accent words, uncovered by a clip-path that follows the line's own view timeline.
 *
 * Screen readers and search engines get the sentence once, as plain text; the drawn lines are
 * aria-hidden. Without scroll-driven animations, or with reduced motion, the lines show filled.
 */
import { highlightParts, plainText } from "../lib/highlight";

interface Props {
  /** One string per line; keep each short enough to fit on one line at desktop width. */
  lines: string[];
  as?: "p" | "h2" | "h3";
  class?: string;
  id?: string;
  /** View-timeline range of each line's fill, in % of `cover` (start, end). Default: staggered by 10%. */
  ranges?: [number, number][];
}
const { lines, as: Tag = "p", class: className, id, ranges } = Astro.props;
const plain = plainText(lines.join(" "));
const range = (i: number) => ranges?.[i] ?? [10 + i * 10, 40 + i * 10];
---

<Tag class:list={["fill-lines", className]} id={id}>
  <span class="sr-only">{plain}</span>
  {
    lines.map((line, i) => (
      <span class="fl" aria-hidden="true">
        <span class="fl-base">{plainText(line)}</span>
        <span class="fl-top" style={`--fill-from:${range(i)[0]}%;--fill-to:${range(i)[1]}%`}>
          {highlightParts(line).map((p) => (p.hl ? <span class="hl">{p.text}</span> : p.text))}
        </span>
      </span>
    ))
  }
</Tag>

<style>
  /* Stack the two copies in the same grid cell. The cell grows to the taller copy, so a
     highlighted line that wraps differently can never escape its line and overlap the next
     element. (The old absolute overlay assumed both copies always wrapped identically.) */
  .fl {
    display: grid;
  }
  .fl-base,
  .fl-top {
    grid-area: 1 / 1;
    color: var(--c-dim);
    text-wrap: balance;
  }
</style>
