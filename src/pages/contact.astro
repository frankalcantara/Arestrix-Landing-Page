---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config";

const channels = [
  {
    label: "GitHub",
    href: SITE.repo,
    icon: "github" as const,
    title: "The project lives here",
    body: "Read the source, open an issue, start a discussion or download the latest beta. Releases, examples and documentation are all in the repository.",
    link: "github.com/frankalcantara/Arestrix",
  },
  {
    label: "X",
    href: SITE.x,
    icon: "x-social" as const,
    title: "Follow the build",
    body: "Release notes, screenshots and short engineering notes. X is the only social channel used for Arestrix updates.",
    link: "@frankalcantara",
  },
];

const more = [
  { label: "Latest release", href: SITE.releases },
  { label: "Discussions", href: SITE.discussions },
  { label: "Issues", href: SITE.issues },
  { label: "Documentation", href: SITE.docs },
];
---

<BaseLayout
  title="Community"
  description="Arestrix is open source. Follow the project on GitHub and X, open a discussion, or read the documentation."
>
  <PageHeader
    title="Build it *with us*"
    lead="Arestrix is developed in the open. Read the source, report a reproducible bug, or tell us which pipeline you are trying to ship."
  />

  <section class="pt-10 pb-24 lg:pb-36">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 class="sr-only">Contact channels</h2>
        <ul class="grid gap-5">
          {
            channels.map((channel) => (
              <li>
                <a
                  href={channel.href}
                  class="channel-card card group flex flex-col gap-5 p-7 sm:p-9"
                  target="_blank"
                  rel="noopener"
                >
                  <span class="flex items-center justify-between gap-4">
                    <span class="flex items-center gap-3">
                      <span class="grid size-11 place-items-center rounded-full bg-card text-card-text">
                        <Icon name={channel.icon} size={22} />
                      </span>
                      <span class="text-xl font-bold tracking-tight">{channel.label}</span>
                    </span>
                    <Icon name="arrow-up-right" size={22} class="shrink-0 text-muted transition-colors group-hover:text-accent" />
                  </span>
                  <span class="block">
                    <span class="block text-2xl font-bold tracking-tight">{channel.title}</span>
                    <span class="mt-3 block text-muted">{channel.body}</span>
                  </span>
                  <span class="font-mono text-sm text-accent">{channel.link}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="mt-12 text-2xl tracking-tight">More on GitHub</h2>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            more.map((item) => (
              <li>
                <a href={item.href} class="more-link card flex items-center justify-between gap-4 px-5 py-4" target="_blank" rel="noopener">
                  <span>{item.label}</span>
                  <Icon name="arrow-up-right" size={18} class="shrink-0 text-muted" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <aside class="lg:col-span-5" aria-labelledby="details-title">
        <h2 id="details-title" class="text-2xl tracking-tight">Project status</h2>
        <p class="mt-4 text-muted">
          {SITE.beta.label} ({SITE.beta.version}) is a development pre-release. The Studio runs on {SITE.beta.platforms}; programs
          generated from a graph currently target Windows. APIs, file formats and flags may change before general availability.
        </p>

        <h2 class="mt-12 text-2xl tracking-tight">Security</h2>
        <p class="mt-4 text-muted">
          Report vulnerabilities privately through{" "}
          <a href={SITE.security} class="text-ink underline decoration-accent underline-offset-4" target="_blank" rel="noopener">GitHub</a>.
          Do not open a public issue for a security problem. The repository's security policy lists the scope and the process.
        </p>

        <h2 class="mt-12 text-2xl tracking-tight">Contributing</h2>
        <p class="mt-4 text-muted">
          Contributions are welcome. Start with the contributing guide, the code of conduct and the open issues labelled
          <span class="text-ink">good first issue</span>.
        </p>

        <a href={SITE.contributing} class="btn btn-secondary mt-8" target="_blank" rel="noopener">
          Contributing guide <Icon name="arrow-up-right" class="icon-shift" />
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .channel-card {
    color: var(--c-ink);
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .channel-card:hover,
  .more-link:hover {
    border-color: var(--accent);
    background: color-mix(in oklab, var(--c-surface) 88%, var(--accent));
  }
</style>
