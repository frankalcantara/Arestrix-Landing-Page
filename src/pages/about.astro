---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import LiveGraph from "../components/LiveGraph.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config";

const audiences = [
  { role: "Platform engineers", note: "Need agent workflows on managed Windows endpoints without shipping a Node or Python runtime to every machine." },
  { role: "Security teams", note: "Cannot put provider keys in project files or send prompts to a multi-tenant automation service." },
  { role: "Operations", note: "Want a standalone runner with a clear progress screen, an integrity check and no IDE." },
  { role: "Researchers and educators", note: "Need a reproducible, local example of agent orchestration that can be inspected end to end." },
  { role: "IT and release managers", note: "Want MSI/MSIX packaging and artifacts they can review, version and sign off." },
];

const principles = [
  {
    title: "Design visually",
    text: "The graph is the source of truth: agents, tools, decisions and feedback loops on one canvas, validated before a run starts.",
  },
  {
    title: "Compile natively",
    text: "Arestrix generates C++20 and compiles it with Taskflow. You can read the code, diff it and build it outside the Studio.",
  },
  {
    title: "Distribute as software",
    text: "Export a standalone runner with an HMAC integrity manifest, then package it as MSI or MSIX for managed Windows deployment.",
  },
];

const notFor = [
  "A hosted automation service that keeps your projects and prompts",
  "An Electron app with a browser runtime on every endpoint",
  "A prompt UI that produces no artifact you can review",
  "A workflow interpreter that hides the execution model",
  "A place to store provider keys in the project file",
  "A closed format you cannot diff or version",
];
---

<BaseLayout
  title="Project"
  description={`${SITE.name} is an open-source desktop studio and native compiler for AI agent pipelines. Who it is for, how it works, and what it deliberately is not.`}
>
  <PageHeader
    title="Agent pipelines deserve *software discipline*"
    lead="Arestrix treats a pipeline as a program: designed, versioned, compiled and packaged like anything else in production."
  >
    <p class="load-in mt-8 max-w-2xl text-muted" style="--d:3">
      {SITE.beta.label} · {SITE.beta.version} · {SITE.beta.platforms}. Beta APIs, file formats and command-line flags may change
      before general availability.
    </p>
  </PageHeader>

  <section class="section" aria-labelledby="audience-title">
    <div class="container-x grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading
          id="audience-title"
          title="Built for the people who *run it*"
          lead="The Studio is for the person who designs the graph. The runner is for the person who has to operate it."
        />
        <div class="mt-16 hidden max-w-xs lg:block">
          <LiveGraph label="Graph · live" />
        </div>
      </div>
      <ul class="stagger divide-y divide-line border-y border-line lg:col-span-7">
        {
          audiences.map((item, i) => (
            <li class="grid gap-2 py-7 sm:grid-cols-[14rem_1fr] sm:gap-8" style={`--i:${i}`}>
              <h3 class="text-xl">{item.role}</h3>
              <p class="text-muted">{item.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="principles-title">
    <div class="container-x">
      <SectionHeading id="principles-title" title="How it *works*" />
      <ul class="stagger mt-14 grid gap-6 md:grid-cols-3">
        {
          principles.map((item, i) => (
            <li class="card p-7" style={`--i:${i}`}>
              <h3 class="text-xl">{item.title}</h3>
              <p class="mt-3 text-muted">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="pb-24 lg:pb-36" aria-labelledby="not-title">
    <div class="container-x">
      <div class="reveal rounded-3xl border border-cap-card-border bg-cap-card p-8 text-cap-card-text sm:p-12 lg:p-16">
        <p class="eyebrow text-cap-card-text">A deliberate scope</p>
        <h2 id="not-title" class="h-section mt-3 text-accent">What Arestrix is not</h2>
        <ul class="mt-10 grid gap-4 text-lg sm:grid-cols-2">
          {
            notFor.map((item) => (
              <li class="flex gap-3">
                <Icon name="x" size={22} class="mt-0.5 shrink-0" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-12 flex flex-col gap-3 sm:flex-row">
          <a href={SITE.docs} class="btn btn-primary btn-lg" target="_blank" rel="noopener">Read the documentation</a>
          <a href={SITE.repo} class="btn btn-secondary btn-lg" target="_blank" rel="noopener">Source on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
