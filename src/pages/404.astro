---
import BaseLayout from "../layouts/BaseLayout.astro";
import StudioShot from "../components/StudioShot.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="container-x grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-2">
    <div>
      <p class="eyebrow text-accent">Error 404</p>
      <h1 class="h-display mt-4"><span class="dim">This page is</span> <span class="hl">off the graph</span></h1>
      <p class="lead mt-6 max-w-lg">It moved or never existed. Try one of these instead.</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary btn-lg">Home <Icon name="arrow-right" class="icon-shift" /></a>
        <a href="/services/" class="btn btn-secondary btn-lg">Capabilities</a>
        <a href="/contact/" class="btn btn-secondary btn-lg">Community</a>
      </div>
    </div>
    <StudioShot
      src="/media/studio-graph.webp"
      alt="Arestrix Studio graph canvas"
      width={1320}
      height={760}
      label="Graph · 404"
      loading="eager"
      class="mx-auto w-full max-w-sm"
    />
  </section>
</BaseLayout>
