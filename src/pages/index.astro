---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Statement from "../components/sections/Statement.astro";
import MediaPanel from "../components/sections/MediaPanel.astro";
import Services from "../components/sections/Services.astro";
import Delegation from "../components/sections/Delegation.astro";
import FeatureGrid from "../components/sections/FeatureGrid.astro";
import MemorySection from "../components/sections/MemorySection.astro";
import GatewaySection from "../components/sections/GatewaySection.astro";
import Teams from "../components/sections/Teams.astro";
import Split from "../components/sections/Split.astro";
import Process from "../components/sections/Process.astro";
import Comparison from "../components/sections/Comparison.astro";
import Pricing from "../components/sections/Pricing.astro";
import Faq from "../components/sections/Faq.astro";
import Download from "../components/sections/Download.astro";
import FinalCta from "../components/sections/FinalCta.astro";
---

<BaseLayout>
  <div class="hero-wrap">
    <Hero />
    <Statement />
  </div>
  <MediaPanel />
  <Services />
  <Delegation />
  <FeatureGrid />
  <MemorySection />
  <GatewaySection />
  <Teams />
  <Split />
  <Process />
  <Comparison />
  <Pricing />
  <Faq />
  <Download />
  <FinalCta />
</BaseLayout>

<style>
  /* The hero starts under the fixed header (the page's top padding is taken back here). On wide
     screens it is sticky inside this wrapper, so the statement block slides up over it. */
  .hero-wrap {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
  }
  @media (min-width: 1001px) {
    .hero-wrap :global(.hero) {
      position: sticky;
      top: 0;
    }
  }
</style>
