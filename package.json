{
  "name": "arestrix-landing-page",
  "type": "module",
  "version": "1.0.0",
  "description": "The Arestrix landing page: a static Astro site for the open-source visual compiler for AI agent pipelines.",
  "license": "MIT",
  "keywords": [
    "astro",
    "arestrix",
    "ai-agents",
    "cpp20",
    "taskflow",
    "landing-page"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cf": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "astro check",
    "test:local": "node scripts/test-local.mjs",
    "test:cf": "node scripts/test-local.mjs --cf",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.153.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
