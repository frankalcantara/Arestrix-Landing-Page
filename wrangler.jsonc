{
  // Cloudflare Workers static assets: `npm run deploy` uploads ./dist.
  // There is no Worker script and no form backend; every page is static.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arestrix",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
